# Local harness settings. Copy to .env (git-, docker- and force-ignored) and
# fill in. `npm run dev` loads .env; nothing here is deployed to the org.

# Mock account the harness sign-in checks against (scripts/mock-backend.mjs).
PICSITE_MOCK_USERNAME=your-username
PICSITE_MOCK_PASSWORD=change-me
PICSITE_MOCK_COMPANY=Example Company LLC
PICSITE_MOCK_CAGE_CODE=00000
