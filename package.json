{
  "name": "picsite",
  "version": "0.1.0",
  "private": true,
  "description": "Army test range request portal - LWC components with a local LWR preview harness",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync-lwr-modules.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run sync && lwr build",
    "start": "node scripts/run.mjs",
    "serve": "lwr start",
    "sample-data": "node scripts/export-sample-data.mjs"
  },
  "dependencies": {
    "lwc": "9.5.1",
    "lwr": "0.24.3"
  }
}
