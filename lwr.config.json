                "path": "$rootDir/force-app/main/default/lwc/capabilityList/capabilityList.js"
            },
            {
                "name": "c/ctaBand",
                "path": "$rootDir/force-app/main/default/lwc/ctaBand/ctaBand.js"
            },
            {
                "name": "c/eventBanner",
                "path": "$rootDir/force-app/main/default/lwc/eventBanner/eventBanner.js"
            },
            {
                "name": "c/fileUploader",
                "path": "$rootDir/src/mock/fileUploader/fileUploader.js"
            },
            {
                "name": "c/govBanner",
                "path": "$rootDir/src/mock/govBanner/govBanner.js"
            },
            {
                "name": "c/heroBanner",
                "path": "$rootDir/force-app/main/default/lwc/heroBanner/heroBanner.js"
