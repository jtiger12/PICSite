            },
            {
                "name": "c/portalApi",
                "path": "$rootDir/src/mock/portalApi/portalApi.js"
            },
            {
                "name": "c/portalModel",
                "path": "$rootDir/force-app/main/default/lwc/portalModel/portalModel.js"
            },
            {
                "name": "c/processStepper",
                "path": "$rootDir/force-app/main/default/lwc/processStepper/processStepper.js"
            },
            {
                "name": "c/quickAccessPanel",
                "path": "$rootDir/force-app/main/default/lwc/quickAccessPanel/quickAccessPanel.js"
            },
            {
                "name": "c/rangeExplorer",
                "path": "$rootDir/force-app/main/default/lwc/rangeExplorer/rangeExplorer.js"
