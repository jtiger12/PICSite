            {
                "name": "c/requestTracker",
                "path": "$rootDir/force-app/main/default/lwc/requestTracker/requestTracker.js"
            },
            {
                "name": "c/siteFooter",
                "path": "$rootDir/force-app/main/default/lwc/siteFooter/siteFooter.js"
            },
            {
                "name": "c/siteHeader",
                "path": "$rootDir/force-app/main/default/lwc/siteHeader/siteHeader.js"
            },
            {
                "name": "c/statusChip",
                "path": "$rootDir/force-app/main/default/lwc/statusChip/statusChip.js"
            },
            {
                "name": "c/valueProps",
                "path": "$rootDir/force-app/main/default/lwc/valueProps/valueProps.js"
            }
        ]
    },
    "assets": [
        {
            "alias": "assetsDir",
            "dir": "$rootDir/src/assets",
            "urlPath": "/assets"
        }
    ],
    "routes": [
        {
            "id": "home",
            "path": "/",
            "rootComponent": "picsite/home",
            "layoutTemplate": "$layoutsDir/main.html"
        },
        {
            "id": "ranges",
            "path": "/ranges",
            "rootComponent": "picsite/ranges",
            "layoutTemplate": "$layoutsDir/main.html"
        },
        {
            "id": "request",
            "path": "/request",
            "rootComponent": "picsite/request",
            "layoutTemplate": "$layoutsDir/main.html"
        },
        {
            "id": "track",
            "path": "/track",
            "rootComponent": "picsite/track",
            "layoutTemplate": "$layoutsDir/main.html"
        },
        {
            "id": "login",
            "path": "/login",
            "rootComponent": "picsite/login",
            "layoutTemplate": "$layoutsDir/main.html"
        },
        {
            "id": "request-account",
            "path": "/request-account",
            "rootComponent": "picsite/requestAccount",
            "layoutTemplate": "$layoutsDir/main.html"
        }
    ]
}
