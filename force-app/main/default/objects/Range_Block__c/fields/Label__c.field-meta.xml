<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Label__c</fullName>
    <description>What the range office's Lightning calendar and list views show for the block: the range and the public label or type.</description>
    <externalId>false</externalId>
    <formula>Range__r.Name &amp; " - " &amp; IF(ISBLANK(Public_Label__c), TEXT(Type__c), Public_Label__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Label</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
